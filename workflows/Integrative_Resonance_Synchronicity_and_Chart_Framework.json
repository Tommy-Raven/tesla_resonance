{
  "workflow.framework": {
    "name": "Integrative_Resonance_Synchronicity_and_Chart_Framework",
    "abbreviation": "IRSC",
    "version": "1.2.0",
    "methodology": "retrospective_structural_evaluation",
    "description": "Deterministic multi-chart workflow integrating Tesla-style triadic numeric resonance, chronological synchronicity analysis, and comparative astrological evaluation. Excludes prediction, causal attribution, and user-desire-driven outputs."
  },

  "authority": {
    "numeric_modeling": "descriptive_structural",
    "symbolic_interpretation": "retrospective_only",
    "causation_claims_allowed": false,
    "prediction_allowed": false,
    "memory_inference_allowed": false,
    "user_desire_alignment_allowed": false
  },

  "lens.triadic_resonance": {
    "name": "Tesla_Resonance_Structural_Model",
    "version": "1.0.0",
    "scope": "numeric_and_wave_structure_only",
    "ontology_reference": "tesla_resonance_ontology@1.0.0",
    "workflow_reference": "Tesla_Resonance_Workflow@1.3",

    "layers": {
      "base_triadic_numbers": {
        "id": "L1",
        "elements": [3, 6, 9],
        "function": "harmonic_scaffold_and_phase_alignment",
        "properties": {
          "numeric_role": "triadic_rotation_and_modular_repetition",
          "geometric_analogy": ["triangle", "hexagon", "envelope_closure"],
          "wave_role": "phase_anchoring"
        },
        "sub_layers": {
          "3": {
            "role": "initiator",
            "wave_function": "primary_phase_anchor"
          },
          "6": {
            "role": "reinforcement",
            "wave_function": "constructive_interference"
          },
          "9": {
            "role": "closure",
            "wave_function": "phase_reset"
          }
        },
        "co_parent_numbers": {
          "values": ["369", "963"],
          "role": "sequential_and_mirrored_flow"
        }
      },

      "prime_counterpoints": {
        "id": "L2",
        "description": "Non_triadic_irregularities",
        "function": "cycle_disruption_and_counterpoint"
      },

      "rational_irrational_ratios": {
        "id": "L3",
        "description": "alignment_and_drift_across_triadic_scaffold"
      },

      "sine_cosine_oscillations": {
        "id": "L4",
        "description": "numeric_to_oscillatory_translation"
      },

      "three_phase_rotation": {
        "id": "L5",
        "description": "triadic_rotational_stability_model"
      },

      "wave_interference_harmonics": {
        "id": "L6",
        "description": "constructive_and_destructive_interference"
      },

      "fractal_chaotic_emergence": {
        "id": "L7",
        "description": "emergent_complexity_and_sensitivity"
      },

      "base3_ternary_lens": {
        "id": "L8",
        "description": "ternary_representation_and_modular_folding"
      }
    },

    "continuum_flow": {
      "order": [
        "base_triadic_numbers",
        "prime_counterpoints",
        "rational_irrational_ratios",
        "sine_cosine_oscillations",
        "three_phase_rotation",
        "wave_interference_harmonics",
        "fractal_chaotic_emergence",
        "base3_ternary_lens"
      ]
    }
  },

  "lens.synchronicity": {
    "name": "Chronological_Synchronicity_Evaluation_Framework",
    "abbreviation": "CSEF",
    "version": "1.0.0",
    "methodology": "retrospective_pattern_analysis",

    "assumptions": {
      "spontaneity": true,
      "no_forethought": true,
      "meaning_post_hoc_only": true,
      "numbers_symbolic_not_causal": true
    },

    "inputs": {
      "accepted_types": [
        "clock_time",
        "calendar_date",
        "numeric_cluster",
        "environmental_metric",
        "standalone_integer"
      ],
      "required_metadata": [
        "sequence_order",
        "context_type",
        "timestamp_known"
      ],
      "optional_metadata": [
        "location",
        "emotional_state",
        "activity_context"
      ]
    },

    "processing": {
      "order": [
        "event_level_analysis",
        "structural_decomposition",
        "numerological_reduction",
        "contextual_encoding",
        "chronological_alignment",
        "pattern_aggregation",
        "phase_transition_detection",
        "integration_classification"
      ],

      "event_level_analysis": {
        "digit_analysis": true,
        "format_analysis": true,
        "environmental_symbolism_allowed": true,
        "clock_specific_logic": true
      },

      "structural_decomposition": {
        "split_digits": true,
        "preserve_order": true,
        "detect_progression": true,
        "detect_mirroring": true,
        "detect_thresholds": true
      },

      "numerological_reduction": {
        "primary": "sum_digits",
        "secondary": "repeat_until_single_digit",
        "retain_master_numbers": [11, 22, 33]
      },

      "contextual_encoding": {
        "clock_time": "temporal_threshold",
        "calendar_date": "cycle_position",
        "environmental_metric": "capacity_symbolism",
        "numeric_cluster": "reinforcement_signal",
        "standalone_integer": "directive_marker"
      },

      "pattern_aggregation": {
        "frequency_analysis": true,
        "cycle_detection": true,
        "theme_clustering": true
      },

      "phase_transition_detection": {
        "threshold_progression": true,
        "role_redefinition": true,
        "integration_markers": true
      },

      "integration_classification": {
        "action": "external_change",
        "integration": "internal_clarification",
        "observation": "log_only"
      }
    }
  },

  "integration": {
    "numeric_structures_source": "lens.triadic_resonance",
    "symbolic_interpretation_source": "lens.synchronicity",
    "allowed_interaction_mode": "structural_reference_only",
    "disallowed": [
      "causal_claims",
      "predictive_mapping",
      "forced_symbolism",
      "free_energy_claims",
      "metaphysical_causation"
    ]
  },

  "output": {
    "primary_artifacts": [
      "triadic_structure_map",
      "chronological_log",
      "pattern_summary",
      "phase_transition_report"
    ],
    "secondary_artifacts": [
      "csv_dataset",
      "json_dataset",
      "visual_maps_optional"
    ],
    "constraints": {
      "no_prediction": true,
      "no_causation_claims": true,
      "no_symbolic_forcing": true,
      "no_user_outcome_pandering": true
    }
  },

  "operational_scope": {
    "input_data_types": [
      "user_provided_astrological_chart",
      "natal_chart",
      "geological_chart",
      "progressed_chart",
      "transit_chart"
    ],

    "allowed_operations": {
      "compilation": true,
      "inspection": true,
      "categorization": true,
      "comparison": true,
      "contrasting": true,
      "parsing": true
    },

    "astrological_analysis_capabilities": {
      "independent_generic_readings": true,
      "natal_chart_reading": true,
      "progressive_chart_reading": true,
      "chart_synastry_pairwise": true,
      "chart_synastry_group": true,
      "group_readings_multi_chart": true,
      "natal_to_current_planet_alignment": true
    },

    "astrological_knowledge_base": {
      "use_known_relations": true,
      "allowed_relations": [
        "planet_positions",
        "house_positions",
        "aspects",
        "conjunctions",
        "oppositions",
        "trines",
        "squares",
        "modes",
        "elements",
        "angles",
        "aspect_patterns"
      ],
      "source_type": "commonly_known_astrological_relationships",
      "hallucinatory_inference_allowed": false
    },

    "interpretation_rules": {
      "derive_only_from": [
        "user_uploaded_data",
        "known_astrological_relationships"
      ],
      "must_be_data_backed": true,
      "must_be_professional_tone": true,
      "must_avoid_user_desire_projection": true,
      "must_avoid_false_inference": true
    }
  }
}
